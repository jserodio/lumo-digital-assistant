    <string name="screen_title">Lumo as Digital Assistant</string>
    <string name="intro">Android only lists apps that declare the assistant role under Digital Assistant. Lumo does not declare it, so it does not appear: this app fills that gap and forwards the invocation to Lumo.</string>

